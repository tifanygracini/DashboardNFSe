# --- banco -----------------------------------------------------------------
# PostgreSQL (Supabase, papel nfse_robo no computador do robô). Vazio = SQLite em data/notas.db
NFSE_DATABASE_URL=

# --- empresas (versão multiempresa) ------------------------------------------
# Pasta de rede com os certificados A1 (.pfx/.p12) de todas as empresas, com subpastas
CERT_PASTA=\servidor\certificados
# Token da API do Acessórias (cadastro das empresas: razão social, regime, código...)
ACESSORIAS_API_TOKEN=
# Campo do Acessórias com o código da empresa no Domínio (vazio = procura nomes comuns; ID = código do Acessórias)
ACESSORIAS_CAMPO_DOMINIO=
# Empresas consultadas ao mesmo tempo no ADN (1 a 16)
NFSE_PARALELO=4

# --- transição da versão de uma empresa só -----------------------------------
# CNPJ das notas que já estão no banco (usado por: nfse-empresas migrar)
CNPJ_EMPRESA=
# Certificado e senha dessa empresa, se ainda não estiverem na CERT_PASTA / no Gerenciador de Credenciais
CERT_PFX=
CERT_SENHA=

# producao | restrita
ADN_AMBIENTE=producao
